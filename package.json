{
  "name": "@magicdoor/mcp",
  "version": "0.1.0",
  "description": "MCP server for MagicDoor \u2014 read your properties, units, leases, tenants and owners from an AI assistant.",
  "license": "UNLICENSED",
  "type": "module",
  "bin": {
    "magicdoor-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\" && tsc",
    "dev": "tsc --watch",
    "prepublishOnly": "npm run typecheck && npm test",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test \"test/**/*.test.js\""
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MagicDoorInc/magicdoor-mcp.git"
  },
  "keywords": [
    "mcp",
    "magicdoor",
    "property-management",
    "model-context-protocol"
  ]
}
